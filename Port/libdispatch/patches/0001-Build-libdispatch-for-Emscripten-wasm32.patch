+// The Emscripten event loop. Emscripten has neither kqueue nor epoll, so the manager thread waits on a
+// condition variable for a poke or for the earliest armed timer. Timer and custom-data sources work as on
+// the other backends; descriptor, signal and process sources do not register (their creation succeeds,
+// their registration fails, as with an unsupported descriptor on the epoll backend).
+
+#include "internal.h"
+#if DISPATCH_EVENT_BACKEND_EMSCRIPTEN
+
+#if !DISPATCH_USE_MGR_THREAD
+#error unsupported configuration
+#endif
+
+static pthread_mutex_t _dispatch_emscripten_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t _dispatch_emscripten_cond;
+static bool _dispatch_emscripten_poked;
+static uint64_t _dispatch_emscripten_targets[DISPATCH_CLOCK_COUNT] = {
+	[DISPATCH_CLOCK_UPTIME] = UINT64_MAX,
+	[DISPATCH_CLOCK_MONOTONIC] = UINT64_MAX,
+	[DISPATCH_CLOCK_WALL] = UINT64_MAX,
+};
+
+static dispatch_once_t _dispatch_emscripten_init_pred;
+
+static void
+_dispatch_emscripten_init(void *context DISPATCH_UNUSED)
+{
+	_dispatch_fork_becomes_unsafe();
+
+	pthread_condattr_t attr;
+	dispatch_assume_zero(pthread_condattr_init(&attr));
+	dispatch_assume_zero(pthread_condattr_setclock(&attr, CLOCK_MONOTONIC));
+	dispatch_assume_zero(pthread_cond_init(&_dispatch_emscripten_cond, &attr));
+	dispatch_assume_zero(pthread_condattr_destroy(&attr));
+
+	_dispatch_trace_item_push(_dispatch_mgr_q.do_targetq, &_dispatch_mgr_q);
+	dx_push(_dispatch_mgr_q.do_targetq, &_dispatch_mgr_q, 0);
+}
+
+#pragma mark dispatch_unote_t
+
+bool
+_dispatch_unote_register_muxed(dispatch_unote_t du DISPATCH_UNUSED)
+{
+	return false;
+}
+
+void
+_dispatch_unote_resume_muxed(dispatch_unote_t du DISPATCH_UNUSED)
+{
+}
+
+bool
+_dispatch_unote_unregister_muxed(dispatch_unote_t du)
+{
+	_dispatch_unote_state_set(du, DU_STATE_UNREGISTERED);
+	return true;
+}
+
+#pragma mark timers
+
+static void
+_dispatch_emscripten_timeout_program(dispatch_clock_t clock, uint64_t target)
+{
+	dispatch_once_f(&_dispatch_emscripten_init_pred, NULL,
+			_dispatch_emscripten_init);
+	pthread_mutex_lock(&_dispatch_emscripten_lock);
+	_dispatch_emscripten_targets[clock] = target;
+	pthread_cond_signal(&_dispatch_emscripten_cond);
+	pthread_mutex_unlock(&_dispatch_emscripten_lock);
+}
+
+void
+_dispatch_event_loop_timer_arm(dispatch_timer_heap_t dth DISPATCH_UNUSED,
+		uint32_t tidx, dispatch_timer_delay_s range,
+		dispatch_clock_now_cache_t nows)
+{
+	dispatch_clock_t clock = DISPATCH_TIMER_CLOCK(tidx);
+	uint64_t target = range.delay + _dispatch_time_now_cached(clock, nows);
+	_dispatch_emscripten_timeout_program(clock, target);
+}
+
+void
+_dispatch_event_loop_timer_delete(dispatch_timer_heap_t dth DISPATCH_UNUSED,
+		uint32_t tidx)
+{
+	_dispatch_emscripten_timeout_program(DISPATCH_TIMER_CLOCK(tidx),
+			UINT64_MAX);
+}
+
+static void
+_dispatch_event_merge_timer(dispatch_clock_t clock)
+{
+	dispatch_timer_heap_t dth = _dispatch_timers_heap;
+	uint32_t tidx = DISPATCH_TIMER_INDEX(clock, 0);
+
+	_dispatch_timers_heap_dirty(dth, tidx);
+	dth[tidx].dth_needs_program = true;
+	dth[tidx].dth_armed = false;
+}
+
+#pragma mark dispatch_loop
+
+void
+_dispatch_event_loop_atfork_child(void)
+{
+}
+
+void
+_dispatch_event_loop_poke(dispatch_wlh_t wlh DISPATCH_UNUSED,
+		uint64_t dq_state DISPATCH_UNUSED, uint32_t flags DISPATCH_UNUSED)
+{
+	dispatch_once_f(&_dispatch_emscripten_init_pred, NULL,
+			_dispatch_emscripten_init);
+	pthread_mutex_lock(&_dispatch_emscripten_lock);
+	_dispatch_emscripten_poked = true;
+	pthread_cond_signal(&_dispatch_emscripten_cond);
+	pthread_mutex_unlock(&_dispatch_emscripten_lock);
+}
+
+DISPATCH_NOINLINE
+void
+_dispatch_event_loop_drain(uint32_t flags)
+{
+	bool fired[DISPATCH_CLOCK_COUNT] = { };
+	bool any = false;
+
+	dispatch_once_f(&_dispatch_emscripten_init_pred, NULL,
+			_dispatch_emscripten_init);
+	pthread_mutex_lock(&_dispatch_emscripten_lock);
+	for (;;) {
+		uint64_t wait = UINT64_MAX;
+		for (int clock = 0; clock < DISPATCH_CLOCK_COUNT; clock++) {
+			uint64_t target = _dispatch_emscripten_targets[clock];
+			if (target == UINT64_MAX) {
+				continue;
+			}
+			uint64_t now = _dispatch_time_now((dispatch_clock_t)clock);
+			if (target <= now) {
+				_dispatch_emscripten_targets[clock] = UINT64_MAX;
+				fired[clock] = true;
+				any = true;
+			} else if (target - now < wait) {
+				wait = target - now;
+			}
+		}
+		if (_dispatch_emscripten_poked) {
+			_dispatch_emscripten_poked = false;
+			any = true;
+		}
+		if (any || (flags & KEVENT_FLAG_IMMEDIATE)) {
+			break;
+		}
+		if (wait == UINT64_MAX) {
+			pthread_cond_wait(&_dispatch_emscripten_cond,
+					&_dispatch_emscripten_lock);
+		} else {
+			struct timespec deadline;
+			dispatch_assume_zero(clock_gettime(CLOCK_MONOTONIC, &deadline));
+			uint64_t nsec = (uint64_t)deadline.tv_nsec + wait % NSEC_PER_SEC;
+			deadline.tv_sec += (time_t)(wait / NSEC_PER_SEC + nsec / NSEC_PER_SEC);
+			deadline.tv_nsec = (long)(nsec % NSEC_PER_SEC);
+			pthread_cond_timedwait(&_dispatch_emscripten_cond,
+					&_dispatch_emscripten_lock, &deadline);
+		}
+	}
+	pthread_mutex_unlock(&_dispatch_emscripten_lock);
+
+	for (int clock = 0; clock < DISPATCH_CLOCK_COUNT; clock++) {
+		if (fired[clock]) {
+			_dispatch_event_merge_timer((dispatch_clock_t)clock);
+		}
+	}
+}
+
+void
+_dispatch_event_loop_cancel_waiter(dispatch_sync_context_t dsc)
+{
+	(void)dsc;
+}
+
+void
+_dispatch_event_loop_wake_owner(dispatch_sync_context_t dsc,
+		dispatch_wlh_t wlh, uint64_t old_state, uint64_t new_state)
+{
+	(void)dsc; (void)wlh; (void)old_state; (void)new_state;
+}
+
+void
+_dispatch_event_loop_wait_for_ownership(dispatch_sync_context_t dsc)
+{
+	if (dsc->dsc_release_storage) {
+		_dispatch_queue_release_storage(dsc->dc_data);
+	}
+}
+
+void
+_dispatch_event_loop_ensure_ownership(dispatch_wlh_t wlh)
+{
+	(void)wlh;
+}
+
+void
+_dispatch_event_loop_end_ownership(dispatch_wlh_t wlh, uint64_t old_state,
+		uint64_t new_state, uint32_t flags)
+{
+	(void)wlh; (void)old_state; (void)new_state; (void)flags;
+}
+
+#if DISPATCH_WLH_DEBUG
+void
+_dispatch_event_loop_assert_not_owned(dispatch_wlh_t wlh)
+{
+	(void)wlh;
+}
+#endif
+
+void
+_dispatch_event_loop_leave_immediate(uint64_t dq_state)
+{
+	(void)dq_state;
+}
+
+#endif // DISPATCH_EVENT_BACKEND_EMSCRIPTEN
