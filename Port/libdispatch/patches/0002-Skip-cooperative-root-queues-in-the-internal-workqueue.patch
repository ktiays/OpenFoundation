Subject: Skip cooperative root queues in the internal workqueue

Without DISPATCH_USE_COOPERATIVE_WORKQUEUE the cooperative root queue entries
have no pthread root queue context, yet _dispatch_root_queues_init_once
initialized a thread pool for every entry, writing the thread attributes,
the mediator vtable and its semaphore through a null do_ctxt. They serve
Swift concurrency only; leave them uninitialized.

diff --git a/src/queue.c b/src/queue.c
--- a/src/queue.c
+++ b/src/queue.c
@@ -8680,6 +8680,14 @@
 #if DISPATCH_USE_INTERNAL_WORKQUEUE
 	size_t i;
 	for (i = 0; i < DISPATCH_ROOT_QUEUE_COUNT; i++) {
+		// Without the cooperative workqueue, the cooperative entries carry no
+		// pthread root queue context (do_ctxt is NULL): initializing a pool
+		// through it writes through a null pointer. They serve Swift
+		// concurrency only and are left uninitialized.
+		if (_dispatch_root_queues[i].dq_priority &
+				DISPATCH_PRIORITY_FLAG_COOPERATIVE) {
+			continue;
+		}
 		_dispatch_root_queue_init_pthread_pool(&_dispatch_root_queues[i], 0,
 				_dispatch_root_queues[i].dq_priority);
 	}
