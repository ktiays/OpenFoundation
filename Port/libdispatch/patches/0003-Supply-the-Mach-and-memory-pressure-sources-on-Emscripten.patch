+#pragma mark mach and memory pressure
+
+// Filters of the sources this backend supplies beyond timers and custom data (distinct from EVFILT_* and
+// DISPATCH_EVFILT_* of event_config.h).
+#define DISPATCH_EVFILT_EMSCRIPTEN_MACH_RECV		(-EVFILT_SYSCOUNT - 7)
+#define DISPATCH_EVFILT_EMSCRIPTEN_MACH_SEND		(-EVFILT_SYSCOUNT - 8)
+#define DISPATCH_EVFILT_EMSCRIPTEN_MEMORYSTATUS	(-EVFILT_SYSCOUNT - 9)
+
+// The pending data of a fired receive source (mach_internal.h, which only HAVE_MACH builds include).
+#define DISPATCH_EMSCRIPTEN_MACH_RECV_MESSAGE 0x2
+
+// The Mach waits of src/mach_emscripten.c, the backend's only dependency on libmach: they forward to
+// libmach's watches (<libmach/wait.h>), which this file, built without Mach headers, does not include. A
+// watch of a receive right or port set calls back once when a message is queued while it is armed; a watch
+// of a send right once when the port's receive right is destroyed. A watch is identified by its port name
+// and context; `ready` runs with libmach's lock held.
+#define DISPATCH_EMSCRIPTEN_MACH_WAIT_MESSAGE	0
+#define DISPATCH_EMSCRIPTEN_MACH_WAIT_DEAD_NAME	1
+extern int _dispatch_emscripten_mach_watch(uint32_t name, int event,
+		void (*ready)(void *context), void *context);
+extern void _dispatch_emscripten_mach_watch_arm(uint32_t name, void *context);
+extern void _dispatch_emscripten_mach_unwatch(uint32_t name, void *context);
+
+// One per registered Mach unote: the waiter's context, linked on the pending list while its event waits
+// for the manager thread.
+typedef struct dispatch_muxnote_s {
+	struct dispatch_muxnote_s *dmn_next;
+	dispatch_unote_t dmn_unote;
+	bool dmn_pending;
+} *dispatch_muxnote_t;
+
+// Guarded by _dispatch_emscripten_lock.
+static dispatch_muxnote_t _dispatch_emscripten_pending_head;
+static dispatch_muxnote_t *_dispatch_emscripten_pending_tail =
+		&_dispatch_emscripten_pending_head;
+
+// Called by the Mach library with its port table locked: queues the muxnote and wakes the manager thread.
+// Registration happens on the manager queue, so the event loop is initialized already.
+static void
+_dispatch_emscripten_muxnote_ready(void *context)
+{
+	dispatch_muxnote_t dmn = context;
+	pthread_mutex_lock(&_dispatch_emscripten_lock);
+	if (!dmn->dmn_pending) {
+		dmn->dmn_pending = true;
+		dmn->dmn_next = NULL;
+		*_dispatch_emscripten_pending_tail = dmn;
+		_dispatch_emscripten_pending_tail = &dmn->dmn_next;
+	}
+	pthread_cond_signal(&_dispatch_emscripten_cond);
+	pthread_mutex_unlock(&_dispatch_emscripten_lock);
+}
+
+// Merges the event of a muxnote taken off the pending list, on the manager thread (as
+// _dispatch_kevent_merge does for EVFILT_MACHPORT and the mach-send notifications).
+static void
+_dispatch_emscripten_muxnote_merge(dispatch_muxnote_t dmn)
+{
+	dispatch_unote_t du = dmn->dmn_unote;
+	uintptr_t data;
+
+	// consumed by dux_merge_evt()
+	_dispatch_retain_unote_owner(du);
+	if (du._du->du_filter == DISPATCH_EVFILT_EMSCRIPTEN_MACH_RECV) {
+		_dispatch_unote_state_clear_bit(du, DU_STATE_ARMED);
+		data = DISPATCH_EMSCRIPTEN_MACH_RECV_MESSAGE;
+		os_atomic_store(&du._dr->ds_pending_data, data, relaxed);
+		dux_merge_evt(du._du, EV_ADD|EV_ENABLE|EV_DISPATCH, data, 0);
+	} else {
+		data = DISPATCH_MACH_SEND_DEAD & du._du->du_fflags;
+		if (data) os_atomic_or(&du._dr->ds_pending_data, data, relaxed);
+		dux_merge_evt(du._du, EV_ADD|EV_ENABLE|EV_CLEAR, data, 0);
+	}
+}
+
+const dispatch_source_type_s _dispatch_source_type_mach_recv = {
+	.dst_kind       = "mach_recv",
+	.dst_filter     = DISPATCH_EVFILT_EMSCRIPTEN_MACH_RECV,
+	.dst_flags      = EV_DISPATCH,
+	.dst_fflags     = 0,
+	.dst_mask       = 0,
+	.dst_action     = DISPATCH_UNOTE_ACTION_SOURCE_OR_FFLAGS,
+	.dst_size       = sizeof(struct dispatch_source_refs_s),
+
+	.dst_create     = _dispatch_unote_create_with_handle,
+	.dst_merge_evt  = _dispatch_source_merge_evt,
+
+	.dst_allow_empty_mask = true,
+};
+
+const dispatch_source_type_s _dispatch_source_type_mach_send = {
+	.dst_kind       = "mach_send",
+	.dst_filter     = DISPATCH_EVFILT_EMSCRIPTEN_MACH_SEND,
+	.dst_flags      = EV_CLEAR,
+	.dst_mask       = DISPATCH_MACH_SEND_DEAD,
+	.dst_action     = DISPATCH_UNOTE_ACTION_SOURCE_OR_FFLAGS,
+	.dst_size       = sizeof(struct dispatch_source_refs_s),
+
+	.dst_create     = _dispatch_unote_create_with_handle,
+	.dst_merge_evt  = _dispatch_source_merge_evt,
+};
+
+// Registers and never fires (see the top of this file).
+const dispatch_source_type_s _dispatch_source_type_memorypressure = {
+	.dst_kind       = "memorystatus",
+	.dst_filter     = DISPATCH_EVFILT_EMSCRIPTEN_MEMORYSTATUS,
+	.dst_flags      = EV_DISPATCH,
+	.dst_mask       = DISPATCH_MEMORYPRESSURE_NORMAL
+			|DISPATCH_MEMORYPRESSURE_WARN|DISPATCH_MEMORYPRESSURE_CRITICAL,
+	.dst_action     = DISPATCH_UNOTE_ACTION_SOURCE_OR_FFLAGS,
+	.dst_size       = sizeof(struct dispatch_source_refs_s),
+
+	.dst_create     = _dispatch_unote_create_without_handle,
+	.dst_merge_evt  = _dispatch_source_merge_evt,
+};
+
 #pragma mark dispatch_unote_t
 
 bool
-_dispatch_unote_register_muxed(dispatch_unote_t du DISPATCH_UNUSED)
+_dispatch_unote_register_muxed(dispatch_unote_t du)
 {
-	return false;
+	uint32_t name = (uint32_t)du._du->du_ident;
+	dispatch_muxnote_t dmn;
+	int kr;
+
+	switch (du._du->du_filter) {
+	case DISPATCH_EVFILT_EMSCRIPTEN_MEMORYSTATUS:
+		_dispatch_unote_state_set(du, DISPATCH_WLH_ANON, DU_STATE_ARMED);
+		return true;
+	case DISPATCH_EVFILT_EMSCRIPTEN_MACH_RECV:
+	case DISPATCH_EVFILT_EMSCRIPTEN_MACH_SEND:
+		break;
+	default:
+		return false;
+	}
+
+	dmn = _dispatch_calloc(1u, sizeof(struct dispatch_muxnote_s));
+	dmn->dmn_unote = du;
+	_dispatch_unote_get_linkage(du)->du_muxnote = dmn;
+	// The state is armed before the waiter can fire: a fired waiter only queues the muxnote, which this
+	// (the manager) thread merges later.
+	_dispatch_unote_state_set(du, DISPATCH_WLH_ANON, DU_STATE_ARMED);
+	kr = _dispatch_emscripten_mach_watch(name,
+			du._du->du_filter == DISPATCH_EVFILT_EMSCRIPTEN_MACH_RECV ?
+			DISPATCH_EMSCRIPTEN_MACH_WAIT_MESSAGE :
+			DISPATCH_EMSCRIPTEN_MACH_WAIT_DEAD_NAME,
+			_dispatch_emscripten_muxnote_ready, dmn);
+	if (kr != 0) {
+		_dispatch_unote_state_set(du, DU_STATE_UNREGISTERED);
+		_dispatch_unote_get_linkage(du)->du_muxnote = NULL;
+		free(dmn);
+		return false;
+	}
+	return true;
 }
 
 void
-_dispatch_unote_resume_muxed(dispatch_unote_t du DISPATCH_UNUSED)
+_dispatch_unote_resume_muxed(dispatch_unote_t du)
 {
+	dispatch_muxnote_t dmn = _dispatch_unote_get_linkage(du)->du_muxnote;
+	dispatch_assert(_dispatch_unote_registered(du));
+	if (du._du->du_filter == DISPATCH_EVFILT_EMSCRIPTEN_MACH_RECV) {
+		// Armed first: re-arming fires at once when a message is queued already.
+		_dispatch_unote_state_set_bit(du, DU_STATE_ARMED);
+		_dispatch_emscripten_mach_watch_arm((uint32_t)du._du->du_ident, dmn);
+	}
 }
 
 bool
 _dispatch_unote_unregister_muxed(dispatch_unote_t du)
 {
+	dispatch_unote_linkage_t dul = _dispatch_unote_get_linkage(du);
+	dispatch_muxnote_t dmn = dul->du_muxnote;
+
+	if (dmn) {
+		// Once the waiter is gone the library calls back no more; a queued event is dropped.
+		_dispatch_emscripten_mach_unwatch((uint32_t)du._du->du_ident, dmn);
+		pthread_mutex_lock(&_dispatch_emscripten_lock);
+		if (dmn->dmn_pending) {
+			dispatch_muxnote_t *link = &_dispatch_emscripten_pending_head;
+			while (*link != dmn) {
+				link = &(*link)->dmn_next;
+			}
+			*link = dmn->dmn_next;
+			if (_dispatch_emscripten_pending_tail == &dmn->dmn_next) {
+				_dispatch_emscripten_pending_tail = link;
+			}
+		}
+		pthread_mutex_unlock(&_dispatch_emscripten_lock);
+		dul->du_muxnote = NULL;
+		free(dmn);
+	}
 	_dispatch_unote_state_set(du, DU_STATE_UNREGISTERED);
 	return true;
 }
